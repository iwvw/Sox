{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop-sox",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "sc.exe stop SoxService 2>$null; Get-Process Sox.App,Sox.Service -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 500; exit 0"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Sox.App/Sox.App.csproj",
        "-r",
        "win-x64",
        "-c",
        "Debug"
      ],
      "dependsOn": "stop-sox",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-service",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Sox.Service/Service.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
