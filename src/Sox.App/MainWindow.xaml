<?xml version="1.0" encoding="utf-8" ?>
<winuiex:WindowEx
    x:Class="Sox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sox.App.Controls"
    xmlns:winuiex="using:WinUIEx"
    Activated="MainWindow_Activated"
    Closed="MainWindow_Closed">

    <controls:CardControl x:Name="RootCard">
        <controls:CardControl.MainContent>
            <Grid x:Name="Root">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!--  Left column: the spotlight itself (search + status + results). Its size/position
                      never changes when the preview opens; the preview expands the window rightward.  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Search row  -->
                    <Grid
                        Grid.Row="0"
                        Height="56"
                        Padding="16,0,16,0"
                        ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Scope badge: shown when a keyword scope is active ("g "). Just the engine's
                          icon, sized up; no chip background or label.  -->
                    <Grid
                        x:Name="ScopeBadge"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Image
                            x:Name="ScopeIcon"
                            Width="28"
                            Height="28" />
                        <FontIcon
                            x:Name="ScopeGlyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="18"
                            GotFocus="SearchBox_GotFocus"
                            KeyDown="SearchBox_KeyDown"
                            LostFocus="SearchBox_LostFocus"
                            PlaceholderText="搜索文件、文件夹和应用"
                            PreviewKeyDown="SearchBox_PreviewKeyDown"
                            Style="{StaticResource SoxSearchBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />

                    <Button
                        x:Name="ClearButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ClearButton_Click"
                        Visibility="Collapsed">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>

                    <Image
                        Grid.Column="3"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/search-sparkle.png" />
                    </Grid>

                    <!--  Index status strip (transient, shown while indexing)  -->
                    <Grid
                        x:Name="IndexStatusStrip"
                        Grid.Row="1"
                        Height="28"
                        Padding="16,4,16,4"
                        Background="{ThemeResource LayerOnAcrylicSecondaryBackgroundBrush}"
                        ColumnSpacing="8"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ProgressRing
                            x:Name="IndexProgressRing"
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            Visibility="Collapsed" />

                        <TextBlock
                            x:Name="IndexStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!--  Results  -->
                    <Border
                        x:Name="ResultsHost"
                        Grid.Row="2"
                        BorderBrush="{ThemeResource Sox.DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                        <Grid>
                            <ListView
                                x:Name="ResultList"
                                MaxHeight="444"
                                Padding="2,6"
                                CanDragItems="True"
                                DragItemsStarting="ResultList_DragItemsStarting"
                                IsItemClickEnabled="True"
                                ItemClick="ResultList_ItemClick"
                                ItemContainerStyle="{StaticResource ResultItemContainerStyle}"
                                ItemTemplate="{StaticResource ResultItemTemplate}"
                                RightTapped="ResultList_RightTapped"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="Single">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection />
                                </ListView.ItemContainerTransitions>
                            </ListView>

                            <!--  Action menu view (replaces the list, same card surface)  -->
                            <ListView
                                x:Name="ActionList"
                                Padding="2,6"
                                IsItemClickEnabled="True"
                                ItemClick="ActionList_ItemClick"
                                ItemContainerStyle="{StaticResource ResultItemContainerStyle}"
                                ItemTemplate="{StaticResource ActionItemTemplate}"
                                RightTapped="ActionList_RightTapped"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="Single"
                                Visibility="Collapsed">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection />
                                </ListView.ItemContainerTransitions>
                            </ListView>

                            <StackPanel
                                x:Name="EmptyState"
                                Margin="0,48,0,48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                                <FontIcon
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE721;" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="没有匹配结果" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  Right column: full-height preview pane (merged into the same card).  -->
                <Border
                    x:Name="PreviewHost"
                    Grid.Column="1"
                    BorderBrush="{ThemeResource Sox.DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <Grid x:Name="PreviewRoot">
                        <Image
                            x:Name="PreviewImage"
                            Margin="12"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <ScrollViewer
                            x:Name="PreviewTextScroll"
                            Padding="12"
                            HorizontalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PreviewText"
                                FontFamily="Cascadia Mono, Consolas, monospace"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </controls:CardControl.MainContent>
    </controls:CardControl>
</winuiex:WindowEx>