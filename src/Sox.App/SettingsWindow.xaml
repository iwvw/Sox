<?xml version="1.0" encoding="utf-8" ?>
<winuiex:WindowEx
    x:Class="Sox.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Width="1040"
    Height="720"
    MinWidth="760"
    MinHeight="560"
    Title="Sox 设置">

    <Grid x:Name="RootElement">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom title bar drag region (content extends into the caption; see ExtendsContentIntoTitleBar).
              Only the empty right-hand strip is handed to SetTitleBar: the whole row used to be the drag
              region, which swallowed clicks on the version chip and the update button.  -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/search-sparkle.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Sox 设置" />
                <Border
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2">
                    <TextBlock
                        x:Name="AppVersionText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="v-" />
                </Border>
                <Button
                    x:Name="TitleUpdateButton"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="0"
                    Click="OnTitleUpdateClick"
                    CornerRadius="4"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Padding="10,3"
                    ToolTipService.ToolTip="发现新版本，点击下载并更新"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE895;" />
                        <TextBlock
                            x:Name="TitleUpdateText"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="有新版本" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                Background="Transparent" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            SelectionChanged="NavView_SelectionChanged"
            PaneDisplayMode="Left">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="常规"
                    IsSelected="True"
                    Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="热键" Tag="hotkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="搜索" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="索引" Tag="index">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="网络搜索" Tag="websearch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>
    </Grid>
</winuiex:WindowEx>