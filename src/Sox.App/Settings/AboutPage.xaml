<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sox.App.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24,20,24,24" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Spacing="4">

            <controls:SettingsCard x:Name="VersionCard" Description="Windows 原生文件搜索工具" Header="Sox">
                <TextBlock x:Name="CurrentVersionText" VerticalAlignment="Center" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="检查是否有新版本" Header="版本与更新">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        x:Name="UpdateStatusText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <Button x:Name="CheckButton" Click="OnCheckUpdate" Content="检查更新" />
                    <Button
                        x:Name="UpdateButton"
                        Click="OnApplyUpdate"
                        Content="一键更新"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </controls:SettingsCard>

            <ProgressBar
                x:Name="UpdateProgress"
                MaxWidth="1000"
                Visibility="Collapsed" />

            <controls:SettingsCard Description="仅当发布仓库为私有需要；公开仓库留空即可" Header="GitHub Token">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PasswordBox x:Name="TokenBox" MinWidth="260" PasswordRevealMode="Peek" />
                    <Button Click="OnSaveToken" Content="保存" />
                </StackPanel>
            </controls:SettingsCard>

            <!--  Plain card rather than a SettingsCard: that control lays content in a right-hand column
                  next to its header, which left a wide empty gutter here. A Border gives the list the
                  full card width.  -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Padding="16" Spacing="12">
                    <TextBlock Text="开源组件" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Sox 的构建离不开以下开源项目，在此致谢。"
                        TextWrapping="Wrap" />
                    <ItemsControl x:Name="OssList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding License}" />
                                    </StackPanel>
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{Binding Url}"
                                        NavigateUri="{Binding Url}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
