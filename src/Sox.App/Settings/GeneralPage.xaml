<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sox.App.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24,20,24,24" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Spacing="4">

            <controls:SettingsCard Description="登录 Windows 后自动启动 Sox" Header="开机自启">
                <ToggleSwitch x:Name="StartupToggle" Toggled="OnStartupToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="自启时仅驻留托盘，不弹出搜索框" Header="自启后最小化到托盘">
                <ToggleSwitch x:Name="MinimizeToggle" Toggled="OnMinimizeToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="启动时在后台检查是否有新版本" Header="自动检查更新">
                <ToggleSwitch x:Name="AutoUpdateToggle" Toggled="OnAutoUpdateToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="常驻托盘图标，可从托盘呼出与退出" Header="显示托盘图标">
                <ToggleSwitch x:Name="TrayToggle" Toggled="OnTrayToggled" />
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
