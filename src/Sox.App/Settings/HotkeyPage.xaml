<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sox.App.Settings.HotkeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24,20,24,24">
        <StackPanel MaxWidth="1000" Spacing="4">

            <controls:SettingsCard Description="在输入框内按下组合键即可录制，Backspace 清空；至少含一个修饰键" Header="呼出搜索框">
                <TextBox
                    x:Name="SummonHotkeyBox"
                    MinWidth="220"
                    IsReadOnly="True"
                    KeyDown="OnSummonHotkeyKeyDown" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="恢复默认 Alt+Space" Header="重置">
                <Button Click="OnResetSummon" Content="重置为 Alt+Space" />
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
