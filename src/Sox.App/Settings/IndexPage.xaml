<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Sox.App.Settings.IndexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24,20,24,24">
        <StackPanel MaxWidth="1000" Spacing="4">

            <controls:SettingsCard x:Name="IndexStateCard" Description="索引状态与进度" Header="本地盘索引">
                <TextBlock x:Name="IndexStateText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="重建所选磁盘的索引（需要管理员）" Header="重建索引">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DriveCombo" MinWidth="100" />
                    <Button x:Name="RebuildButton" Click="OnRebuildIndex" Content="重建" />
                    <Button x:Name="CancelIndexButton" Click="OnCancelIndex" Content="取消" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Description="清空服务端日志文件" Header="服务日志">
                <Button Click="OnClearLog" Content="清空日志" />
            </controls:SettingsCard>

            <controls:SettingsExpander Description="按目录调整搜索结果的排序与取舍" Header="优先级" IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="目录规则">
                        <StackPanel Spacing="8">
                            <ListView
                                x:Name="PriorityList"
                                MinWidth="560"
                                MaxHeight="260"
                                SelectionMode="Single"
                                DoubleTapped="OnEditPriority">
                                <ListView.Header>
                                    <Grid Padding="12,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="目录" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="优先级" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding PriorityLabel}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnAddPriority" Content="添加" />
                                <Button Click="OnEditPriority" Content="编辑" />
                                <Button Click="OnDeletePriority" Content="删除" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
