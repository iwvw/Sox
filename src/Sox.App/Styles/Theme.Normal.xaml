<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LayerOnAcrylicPrimaryBackgroundBrush" Color="#50202020" />
            <SolidColorBrush x:Key="LayerOnAcrylicSecondaryBackgroundBrush" Color="Transparent" />

            <!--  Strokes: WinUI defaults sit around 6% alpha and all but vanish on HDR / high-luminance
                  panels. These are deliberately stronger so the card outline and dividers stay legible.  -->
            <SolidColorBrush x:Key="Sox.CardStrokeBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="Sox.DividerBrush" Color="#26FFFFFF" />

            <SolidColorBrush x:Key="Sox.Syntax.Plain" Color="#D4D4D4" />
            <SolidColorBrush x:Key="Sox.Syntax.Keyword" Color="#569CD6" />
            <SolidColorBrush x:Key="Sox.Syntax.String" Color="#CE9178" />
            <SolidColorBrush x:Key="Sox.Syntax.Comment" Color="#6A9955" />
            <SolidColorBrush x:Key="Sox.Syntax.Number" Color="#B5CEA8" />
            <SolidColorBrush x:Key="Sox.Syntax.Type" Color="#4EC9B0" />
            <SolidColorBrush x:Key="Sox.Syntax.Tag" Color="#569CD6" />
            <SolidColorBrush x:Key="Sox.Syntax.Attribute" Color="#9CDCFE" />
            <SolidColorBrush x:Key="Sox.Syntax.Punctuation" Color="#D4D4D4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LayerOnAcrylicPrimaryBackgroundBrush" Color="#A0FFFFFF" />
            <SolidColorBrush x:Key="LayerOnAcrylicSecondaryBackgroundBrush" Color="#66FFFFFF" />

            <SolidColorBrush x:Key="Sox.CardStrokeBrush" Color="#33000000" />
            <SolidColorBrush x:Key="Sox.DividerBrush" Color="#26000000" />

            <SolidColorBrush x:Key="Sox.Syntax.Plain" Color="#1F1F1F" />
            <SolidColorBrush x:Key="Sox.Syntax.Keyword" Color="#0000FF" />
            <SolidColorBrush x:Key="Sox.Syntax.String" Color="#A31515" />
            <SolidColorBrush x:Key="Sox.Syntax.Comment" Color="#008000" />
            <SolidColorBrush x:Key="Sox.Syntax.Number" Color="#098658" />
            <SolidColorBrush x:Key="Sox.Syntax.Type" Color="#267F99" />
            <SolidColorBrush x:Key="Sox.Syntax.Tag" Color="#800000" />
            <SolidColorBrush x:Key="Sox.Syntax.Attribute" Color="#FF0000" />
            <SolidColorBrush x:Key="Sox.Syntax.Punctuation" Color="#1F1F1F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LayerOnAcrylicPrimaryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LayerOnAcrylicSecondaryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="Sox.CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Sox.DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="Sox.Syntax.Plain" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.Keyword" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.String" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.Comment" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.Number" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.Type" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.Tag" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.Attribute" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Sox.Syntax.Punctuation" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
