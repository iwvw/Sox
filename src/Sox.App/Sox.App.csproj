<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Sox.App</RootNamespace>
    <AssemblyName>Sox.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embed the multi-size icon in the exe so Explorer, the taskbar and shortcuts (which take
         icon index 0 from the target) show Sox instead of a generic application icon. -->
    <ApplicationIcon>Assets\sox-tray.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Two release variants share this project. Default (true) is the merged build: .NET and the
         Windows App SDK are carried inside the payload, so nothing has to be installed first. Pass
         -p:SoxSelfContained=false for the split build, which is far smaller but requires the .NET
         Desktop Runtime and the Windows App SDK Runtime (the installer bootstraps both). -->
    <SoxSelfContained Condition="'$(SoxSelfContained)' == ''">true</SoxSelfContained>
    <SelfContained>$(SoxSelfContained)</SelfContained>
    <WindowsAppSDKSelfContained>$(SoxSelfContained)</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- WinUI 3 XAML relies on reflection; trimming breaks compiled bindings (XamlParseException).
         ReadyToRun inflates the payload by tens of MB for little startup benefit here. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <!-- The WindowsAppSDK metapackage drags in the AI, ML (onnxruntime + DirectML, ~45MB) and Widgets
         stacks. Sox uses none of them, so pull them in directly with all assets excluded: a direct
         reference's ExcludeAssets wins over the transitive one, keeping the DLLs out of the output. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.2.3" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.70" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.70" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="WinUIEx" Version="2.8.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.250402" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sox.Core\Core.csproj" />
    <ProjectReference Include="..\Sox.PluginSdk\PluginSdk.csproj" />
    <!-- Compiled in so the App process can register the pinyin alias provider for its own instant
         sources (application / window / history matching). Copied beside Sox.App.exe so the App can
         load it; the service/hook keep their own copy under Service\Plugins. -->
    <ProjectReference Include="..\Plugins\PinyinAlias\PinyinAlias.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!-- The dev build keeps a framework-dependent Service beside the App so F5 debugging finds it
       without a full publish. SelfContained/Platform are pinned here because a publish run passes
       those down as global properties, and an empty RuntimeIdentifier with SelfContained=true is
       NETSDK1191. The published, self-contained Service is produced separately below. -->
  <Target Name="BuildAndCopyService" BeforeTargets="Build">
    <!-- Restore first: the App does not reference the Service, so a plain publish/build only
         restores the App's own dependency graph and a clean checkout has no Service assets
         (NETSDK1004). Incremental, so it is a no-op once Service has been restored. -->
    <MSBuild Projects="..\Sox.Service\Service.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false;Platform=AnyCPU">
      <Output TaskParameter="TargetOutputs" ItemName="ServiceBuildOutputs" />
    </MSBuild>
  </Target>

  <Target Name="CopyServiceToOutput" AfterTargets="Build" DependsOnTargets="BuildAndCopyService">
    <ItemGroup>
      <ServiceFiles Include="..\Sox.Service\bin\$(Configuration)\net10.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceFiles)" DestinationFiles="@(ServiceFiles->'$(OutDir)Service\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- A publish to a custom output directory (-o / -p:PublishDir) drops the WinUI compiled resources:
       Sox.App.pri, the .xbf page fragments and Assets\. They are produced by the build into $(OutDir)
       but are not publish items, so the app crashes on launch (Microsoft.UI.Xaml.dll, 0xc000027b)
       with only "Log initialized" in app.log. Copy them across from the build output. -->
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)Sox.App.pri" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" Condition="Exists('$(OutDir)Sox.App.pri')" />

    <!-- .xbf fragments keep their page subdirectory (Controls\, Settings\, Styles\). -->
    <ItemGroup>
      <_XbfFragments Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XbfFragments)"
          DestinationFiles="@(_XbfFragments->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- Assets\ is copied under its own name, so RecursiveDir is taken relative to Assets\. -->
    <ItemGroup>
      <_AssetFiles Include="$(OutDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetFiles)"
          DestinationFiles="@(_AssetFiles->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish the Service into the App's publish output, under Service\, the layout
       ServiceBootstrapper.ResolveServiceExe and ServicePluginLoader both expect (the latter scans
       Service\Plugins for aliases). It follows the same SelfContained mode as the App: the merged
       build carries the .NET runtime, the split build relies on the machine's. The nested build pins
       SelfContained and Platform explicitly so the outer publish's global properties do not leak in. -->
  <Target Name="PublishServiceToPublishDir" AfterTargets="Publish">
    <MSBuild Projects="..\Sox.Service\Service.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SoxSelfContained);Platform=$(Platform);PublishDir=$(PublishDir)Service\">
      <Output TaskParameter="TargetOutputs" ItemName="ServicePublishOutputs" />
    </MSBuild>
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Keep only the languages the app actually ships; drop the other ~100 locale folders. -->
  <Target Name="TrimPublishLanguages" AfterTargets="Publish">
    <ItemGroup>
      <PublishLanguageDirs Include="$(PublishDir)**" />
    </ItemGroup>
    <Exec Command="powershell -NoProfile -Command &quot;Get-ChildItem -LiteralPath '$(PublishDir)' -Directory | Where-Object { $_.Name -match '^[a-z]{2}(-[A-Za-z]{2,4})?$' -and $_.Name -notin @('en-us','zh-CN','zh-Hans','zh-Hant') } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue&quot;" />
  </Target>

</Project>
